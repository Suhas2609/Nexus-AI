# --- LLM APIs ---
GOOGLE_API_KEY=your_google_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# --- LangSmith Tracing ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=nexus-ai

# --- Vector Store ---
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=nexus_collection

# --- Model Names ---
ANALYST_MODEL=gemini-3.1-flash-lite
CRITIC_MODEL=qwen/qwen3.6-27b
EMBEDDING_MODEL=models/text-embedding-004

# --- RAG Numeric Parameters ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVER_K=4
RETRIEVER_FETCH_K=20
RETRIEVER_LAMBDA_MULT=0.85
MEMORY_WINDOW_K=5

# --- API Config ---
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FASTAPI_BASE_URL=http://localhost:8000

# --- Automation & Eval ---
N8N_PASSWORD=admin
RAGAS_THRESHOLD=0.75